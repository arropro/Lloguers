{
  "name": "lloguers",
  "main": "src/index.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  // La base de dades (D1) i l'espai per als fitxers (KV) es creen sols el primer cop que es publica.
  "d1_databases": [
    { "binding": "DB", "database_name": "lloguers" }
  ],
  // Cada 15 minuts: envia els correus programats. Els avisos dels lloguers només surten un cop al dia, a les 10 de Madrid.
  "triggers": { "crons": ["*/15 * * * *"] },
  "kv_namespaces": [
    { "binding": "BLOBS" }
  ]
}
