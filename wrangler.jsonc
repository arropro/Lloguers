{
  "name": "lloguers",
  "main": "src/index.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  // La base de dades (D1) i l'espai per als fitxers (KV) es creen sols el primer cop que es publica.
  "d1_databases": [
    { "binding": "DB", "database_name": "lloguers" }
  ],
  // Cada dia a les 8:30 i 9:30 UTC; el codi només envia l'avís quan a Madrid són les 10:30, del dia 5 al 10.
  "triggers": { "crons": ["30 8 * * *", "30 9 * * *"] },
  "kv_namespaces": [
    { "binding": "BLOBS" }
  ]
}
